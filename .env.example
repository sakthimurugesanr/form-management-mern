# Local PostgreSQL (docker compose up -d)
DATABASE_URL=postgresql://careflow:careflow_local@localhost:5432/careflow
# Neon alternative: replace DATABASE_URL with your Neon connection string including ?sslmode=require
# DATABASE_URL=postgresql://USER:PASSWORD@YOUR-HOST.neon.tech/neondb?sslmode=require
PORT=4000
APP_ORIGIN=http://localhost:5173
NODE_ENV=development
# Used by npm run admin:create. Choose a strong unique password.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password
ADMIN_NAME=Administrator
# Set to 1 only when behind exactly one trusted reverse proxy.
TRUST_PROXY=0
